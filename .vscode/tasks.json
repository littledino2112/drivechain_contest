{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo-build-bench",
            "type": "cargo",
            "command": "build",
            "args": [
                "--package",
                "thunder",
                "--benches", 
                "--all-features"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$rustc",
            "options": {
                "env": {
                    "RUSTFLAGS": "-C target-cpu=native",
                    "CARGO_TERM_COLOR": "always"
                }
            }
        },
        {
            "label": "cargo-build-bench-manual",
            "type": "shell",
            "command": "cargo",
            "args": [
                "bench",
                "--package",
                "thunder", 
                "--benches",
                "--all-features",
                "--no-run"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always", 
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$rustc",
            "options": {
                "env": {
                    "RUSTFLAGS": "-C target-cpu=native",
                    "CARGO_TERM_COLOR": "always"
                }
            }
        }
    ]
}